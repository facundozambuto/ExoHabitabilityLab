# ExoHabitabilityLab Environment Configuration
# Copy this file to .env and modify as needed

# Application Settings
APP_NAME=ExoHabitabilityLab
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite+aiosqlite:///./exohabitability.db

# External APIs
NASA_API_BASE_URL=https://exoplanetarchive.ipac.caltech.edu/TAP/sync
ESA_API_BASE_URL=https://exoplanet.eu/api

# API Configuration
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# CORS - comma-separated list of allowed origins. Use "*" only in development.
CORS_ALLOW_ORIGINS=*

# Image Generation (optional). Get a free key at https://enter.pollinations.ai/
POLLINATIONS_API_KEY=